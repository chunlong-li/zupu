<view wx:if="{{m}}" class="card">
  <view class="title">{{m.name}}</view>
  <view class="muted">{{m.record_type === '外纪' ? '外纪' : '第' + m.generation + '世'}}{{m.branch ? ' · ' + m.branch : ''}}</view>
  <view class="row"><text class="label">生卒</text><text class="value">{{m.birth_gregorian || '生年未詳'}}　{{deathText === '在世' ? '在世' : deathText}}</text></view>
  <view class="row" wx:if="{{m.zi}}"><text class="label">字</text><text class="value">{{m.zi}}</text></view>
  <view class="row" wx:if="{{m.hao}}"><text class="label">号</text><text class="value">{{m.hao}}</text></view>
  <view class="row" wx:if="{{fatherName}}"><text class="label">父</text><text class="value">{{fatherName}}</text></view>
  <view class="row" wx:if="{{motherName}}"><text class="label">母</text><text class="value">{{motherName}}</text></view>
  <view class="row" wx:if="{{m.native_place}}"><text class="label">籍贯</text><text class="value">{{m.native_place}}</text></view>
  <view class="row" wx:if="{{m.burial_place}}"><text class="label">葬地</text><text class="value">{{m.burial_place}}</text></view>
</view>

<view wx:if="{{spouses.length}}" class="card">
  <view class="title" style="font-size:30rpx;margin-bottom:8rpx">配偶</view>
  <view class="row" wx:for="{{spouses}}" wx:key="id">
    <text>{{item.name}}</text><text class="muted">{{item.type}}</text>
  </view>
</view>

<view wx:if="{{children.length}}" class="card">
  <view class="title" style="font-size:30rpx;margin-bottom:8rpx">子女</view>
  <view class="row" wx:for="{{children}}" wx:key="id" bindtap="goMember" data-id="{{item.id}}">
    <text>{{item.name}}</text><text class="muted">{{item.generation ? '第' + item.generation + '世' : ''}}</text>
  </view>
</view>

<view wx:if="{{loading}}" class="empty">载入中…</view>
