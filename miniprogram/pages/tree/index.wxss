.canvas { position: absolute; left: 0; right: 0; top: 0; bottom: 88rpx; overflow: hidden; background: #f5efe3; }
.stage { position: absolute; left: 0; top: 0; transform-origin: 0 0; }
.node { position: absolute; width: 104px; height: 64px; box-sizing: border-box; display: flex;
  flex-direction: column; align-items: center; justify-content: center;
  background: #fffaf0; border: 1px solid #d9cbb6; border-radius: 8px; }
.node .nm { font-size: 14px; color: #2b2118; }
.node .gen { font-size: 11px; color: #a89880; margin-top: 2px; }
.edge { position: absolute; height: 1px; background: #c9b79c; transform-origin: 0 0; }
.tools { position: absolute; left: 0; right: 0; bottom: 0; height: 88rpx; display: flex; align-items: center;
  justify-content: center; background: #fffaf0; border-top: 1rpx solid #efe3d0; }
.tool { padding: 10rpx 40rpx; background: #8c5a3c; color: #fff; border-radius: 30rpx; font-size: 26rpx; }
