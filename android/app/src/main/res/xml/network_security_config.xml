<?xml version="1.0" encoding="utf-8"?>
<!-- 族谱系统默认是 http://内网IP:8080，必须允许明文；https 的自签证书也放行 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
